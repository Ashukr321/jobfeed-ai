#!/usr/bin/env sh

message=$(cat "$1")

if ! printf '%s\n' "$message" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert|hotfix|structure)(\([a-zA-Z0-9._-]+\))?(!)?: .+'; then
  echo ""
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Format:  type(scope): description"
  echo "         type(scope)!: description   (breaking change)"
  echo ""
  echo "Types:"
  echo "  feat      ✨  A new feature"
  echo "  fix       🐛  A bug fix"
  echo "  hotfix    🚑  Critical hotfix for production"
  echo "  docs      📝  Documentation changes"
  echo "  style     💄  Code style (formatting, semicolons, no logic change)"
  echo "  refactor  ♻️   Code refactoring (no feature or fix)"
  echo "  perf      ⚡  Performance improvement"
  echo "  test      ✅  Adding or updating tests"
  echo "  build     📦  Build system or dependencies"
  echo "  ci        👷  CI/CD pipeline changes"
  echo "  chore     🔧  Maintenance (configs, scripts, tooling)"
  echo "  structure 🏗️   Project/file structure changes (move, rename, reorganize)"
  echo "  revert    ⏪  Revert a previous commit"
  echo ""
  echo "Scope (optional): module or area affected"
  echo "  e.g. auth, api, dashboard, ui, db, config"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add login with Google OAuth"
  echo "  fix(api): handle null response from /users endpoint"
  echo "  hotfix(payments): prevent duplicate charge on retry"
  echo "  docs: update README setup instructions"
  echo "  style(ui): fix button padding inconsistency"
  echo "  refactor(hooks): extract useDebounce from useSearch"
  echo "  perf(dashboard): lazy load chart components"
  echo "  test(auth): add unit tests for login validation"
  echo "  build: upgrade Next.js to v16"
  echo "  ci: add staging deploy workflow"
  echo "  chore: update eslint config"
  echo "  structure: create components and hooks folder hierarchy"
  echo "  structure(auth): move auth pages into route group"
  echo "  revert: revert feat(auth): add login with Google OAuth"
  echo "  feat(api)!: change response format for /users"
  echo ""
  exit 1
fi